# Copy to .env to change any of these (all optional), then run: npm run up
# ASTRA_REPO=/home/<you>/payment_system      (default: ~/payment_system)
# OPENSEARCH_VERSION=2.19.6
# DASHBOARDS_VERSION=2.19.7
# OPENSEARCH_PORT=9200
# DASHBOARDS_PORT=5601
# SHIPPER_PORT=9700
# How many months of traces to keep (current month included); 0 = keep everything
# RETENTION_MONTHS=3
# Resource caps
# OPENSEARCH_HEAP=768m
# OPENSEARCH_CPUS=1.5
# OPENSEARCH_MEM_LIMIT=1536m
# DASHBOARDS_CPUS=1.0
# DASHBOARDS_MEM_LIMIT=1g
# SHIPPER_CPUS=0.5
# SHIPPER_MEM_LIMIT=256m
# Where the logs come from
# REDIS_HOST=nps_redis
# LOG_REDIS_KEY=nps-logs
