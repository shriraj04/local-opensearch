# Copy to .env to change any of these (all optional), then run: npm run up
# ASTRA_REPO=/home/<you>/payment_system      (default: ~/payment_system)
# OPENSEARCH_VERSION=2.19.6
# DASHBOARDS_VERSION=2.19.7
# OPENSEARCH_PORT=9200
# DASHBOARDS_PORT=5601
# SHIPPER_PORT=9700
# How many days of traces to keep (today included); older days are removed by themselves. 0 = keep everything
# RETENTION_DAYS=5
# Below this much free disk OpenSearch pauses writing (nothing is lost; it resumes by itself). 0 = off
# DISK_MIN_FREE_GB=2
# A Java 17 to 21 for the first OpenSearch build, if setup does not find one by itself (no sudo needed)
# JAVA_HOME=/home/<you>/.testsigma/agent/jre
# Resource caps
# OPENSEARCH_HEAP=320m
# OPENSEARCH_CPUS=1.5
# OPENSEARCH_MEM_LIMIT=500m
# DASHBOARDS_CPUS=1.0
# DASHBOARDS_MEM_LIMIT=1g
# SHIPPER_CPUS=0.5
# SHIPPER_MEM_LIMIT=256m
# Where the logs come from
# REDIS_HOST=nps_redis
# LOG_REDIS_KEY=nps-logs
